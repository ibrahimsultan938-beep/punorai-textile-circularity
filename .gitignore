# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Temporary and local backups
backup_*/
*.bak
*.pre_redesign.bak

# Scratch scripts and temporary development artifacts
scratch/

# SQLite temporary runtime journals and WAL files
# Note: circulo.db is intentionally preserved for standalone demo deployment
*.db-wal
*.db-shm
*.db-journal

# Environment variables & secrets
.env
.env.local
.env.*.local
!.env.example

# Temporary logs and test outputs
*.log
*.tmp
.system_generated/

# OS-specific files
.DS_Store
Thumbs.db
desktop.ini
